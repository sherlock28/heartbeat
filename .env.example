# Copia este archivo a .env y ajusta los valores

# --- Acceso al panel ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contraseña
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Monitoreo ---
# Segundos entre rondas de chequeo
CHECK_INTERVAL=30
# Segundos de espera por chequeo
CHECK_TIMEOUT=2
# Fallos seguidos para declarar una VM caída (3 x 30s = ~90s)
FAIL_THRESHOLD=3
# Éxitos seguidos para declararla recuperada
RECOVER_THRESHOLD=1
# Avisar si una VM recién registrada ya está caída
NOTIFY_INITIAL_DOWN=true

# --- Zona horaria de los mensajes y el panel ---
TZ=America/Argentina/Buenos_Aires
